# Exclude reverse-engineering evidence and generated build artifacts from
# GitHub language statistics while retaining them in the repository.
/analysis/** linguist-generated=true
/build-runs/** linguist-generated=true
/runtime-builds/** linguist-generated=true

# Third-party libraries are dependencies, not reconstructed game code.
/third_party/** linguist-vendored=true

# This directory also contains live runtime code. Exclude only original
# executable decompiler exports; keep *_rebuilt.c and other runtime sources.
/src/decompiled/*.exe.c linguist-generated=true

# Keep pinned original evidence byte-identical in Linux and Windows checkouts.
/src/decompiled/*.exe.c text eol=lf
/docs/decompiler-cleanup-r126/original-stage-evidence.json text eol=lf
